# Single env file for the whole stack, copied to .env for local dev.
# docker-compose.yml passes only the relevant subset into each service.

# --- MariaDB (mariadb + api services) ---
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=event_webshop
MARIADB_USER=event_webshop
MARIADB_PASSWORD=event_webshop

# --- api service ---
APP_ENV=local
IMAGES_API_BASE_URL=https://bo.light-stg.de
# true enables Xdebug; toggling only needs `docker compose up -d`, no rebuild.
XDEBUG=false

# --- web service (Vite build-time, VITE_ prefix required to reach the client bundle) ---
VITE_API_URL=http://localhost:8080
VITE_IMAGES_API_BASE_URL=https://bo.light-stg.de
