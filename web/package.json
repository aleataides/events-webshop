    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^3.2.0",
    "eslint-plugin-unused-imports": "^4.1.0",
