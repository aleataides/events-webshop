{
    "name": "event-webshop/api",
    "type": "project",
    "require": {
        "php": "^8.4",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "doctrine/orm": "^3.3",
        "doctrine/migrations": "^3.8",
        "monolog/monolog": "^3.7",
        "ramsey/uuid": "^4.7",
        "symfony/console": "^8.1",
        "vlucas/phpdotenv": "^5.6",
        "predis/predis": "^3.6",
        "tuupola/cors-middleware": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.64",
        "fakerphp/faker": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse src",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
